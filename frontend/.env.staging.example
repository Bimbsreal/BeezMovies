# Staging only. These values are public in the browser.
# Copy to frontend/.env.staging. Do not put secrets in this file.
# Next.js reads NEXT_PUBLIC_* at build time.

NEXT_PUBLIC_SITE_ENV=staging
NEXT_PUBLIC_API_URL=https://api.staging.beezmovies.example/api/v1
NEXT_PUBLIC_SITE_URL=https://staging.beezmovies.example
