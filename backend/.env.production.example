# Production only. Names and placeholders. Fill these in the host secret store.
# Do not commit the filled file. Do not reuse development or staging values.
# Downloads fail closed when the handoff value is empty.

NODE_ENV=production
PORT=5000
LOG_SERVICE=beezmovies-api
DATABASE_URL=
REDIS_URL=
CORS_ORIGIN=https://beezmovies.example
LOG_LEVEL=info
BODY_LIMIT=1mb
PG_POOL_MAX=10
MEDIA_PROVIDERS=
MEDIA_HANDOFF_SECRET=
