# BeezMovies environment examples. Placeholders only. Never put real credentials here.
# Copy to backend/.env for local development. Production must use its own secret store.

# -----------------------------------------------------------------------------
# development
# Local API on port 5000. The password below is a documented local fixture.
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://beezmovies:beezmovies_local@localhost:5432/beezmovies
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
BODY_LIMIT=1mb
PG_POOL_MAX=10
MEDIA_PROVIDERS=development-media
MEDIA_HANDOFF_SECRET=beezmovies-local-handoff

# -----------------------------------------------------------------------------
# test
# The test runner sets NODE_ENV=test and uses the same local DATABASE_URL.
# Do not point tests at a production database.
# REDIS_URL may be unset. Rate limiters are disabled when NODE_ENV=test.
# -----------------------------------------------------------------------------
# NODE_ENV=test
# DATABASE_URL=postgresql://beezmovies:beezmovies_local@localhost:5432/beezmovies
# MEDIA_HANDOFF_SECRET=beezmovies-local-handoff

# -----------------------------------------------------------------------------
# production
# Set these in the host secret store. Do not copy the development values.
# NODE_ENV=production turns off the local handoff fallback, seed loading,
# and non-production error.debug stacks. HSTS is sent only in this mode.
# Leave MEDIA_HANDOFF_SECRET empty and downloads fail closed.
# REDIS_URL is optional. CORS_ORIGIN must be the real site origin, never *.
# -----------------------------------------------------------------------------
# NODE_ENV=production
# PORT=5000
# Host, port, database, user, password, and TLS are all inside DATABASE_URL.
# Use sslmode=verify-full when the provider supplies a certificate chain.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# REDIS_URL=
# CORS_ORIGIN=https://example.com
# LOG_LEVEL=info
# BODY_LIMIT=1mb
# PG_POOL_MAX=10
# MEDIA_PROVIDERS=
# MEDIA_HANDOFF_SECRET=
