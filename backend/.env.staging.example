# Staging only. Placeholders. Copy to backend/.env.staging and fill CHANGE_ME
# from the staging secret store. Never commit the filled file.
# Do not reuse development or production passwords.

NODE_ENV=production
PORT=5000
LOG_SERVICE=beezmovies-api
DATABASE_URL=postgresql://STAGING_USER:CHANGE_ME@STAGING_DB_HOST:5432/beezmovies_staging?sslmode=verify-full
REDIS_URL=rediss://:CHANGE_ME@STAGING_REDIS_HOST:6379
CORS_ORIGIN=https://staging.beezmovies.example
LOG_LEVEL=info
BODY_LIMIT=1mb
PG_POOL_MAX=10
MEDIA_PROVIDERS=development-media
MEDIA_HANDOFF_SECRET=CHANGE_ME
